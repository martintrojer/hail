{
  "openapi": "3.1.0",
  "info": {
    "title": "hail",
    "description": "Task-oriented HTTP+JSON API for hail (self-hosted hey.com-style email front-end on top of Stalwart/JMAP). See docs/design.md §7 for the verb/view model.",
    "contact": {
      "name": "Martin Trojer",
      "email": "martin.trojer@gmail.com"
    },
    "license": {
      "name": "AGPL-3.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/threads/{thread_id}": {
      "get": {
        "tags": [
          "threads"
        ],
        "operationId": "get_thread",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "JMAP thread id to render as a sanitized document.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thread rendered as sanitized HTML messages.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadViewResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid thread id."
          },
          "401": {
            "description": "Missing or invalid session."
          },
          "404": {
            "description": "Thread not found."
          },
          "500": {
            "description": "Thread assembly failed."
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe.",
        "description": "Returns 204 No Content if the process is up enough to accept HTTP.\nIntended for container orchestrators (Kubernetes `livenessProbe`,\nDocker `HEALTHCHECK`, etc.) — a failing liveness check should\nrestart the container.",
        "operationId": "healthz",
        "responses": {
          "204": {
            "description": "Process is alive."
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Readiness probe.",
        "description": "Returns 200 OK once the SQLite pool answers `SELECT 1`, otherwise\n503 Service Unavailable. Designed for `readinessProbe` style\ngating: a failing readiness check should remove the instance from\nload-balancer rotation but *not* restart it.\n\nPer design.md §7.5 the production check will also verify the JMAP\nsession; that's wired in by the `jmap-eventsource` task.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "All dependencies reachable."
          },
          "503": {
            "description": "A dependency is unhealthy."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BlockedTrackerResponse": {
        "type": "object",
        "required": [
          "src",
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "src": {
            "type": "string"
          }
        }
      },
      "Participant": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ThreadMessageResponse": {
        "type": "object",
        "required": [
          "email_id",
          "from",
          "to",
          "html",
          "preview",
          "blocked_trackers"
        ],
        "properties": {
          "blocked_trackers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlockedTrackerResponse"
            }
          },
          "email_id": {
            "type": "string"
          },
          "from": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          },
          "html": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "to": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          }
        }
      },
      "ThreadViewResponse": {
        "type": "object",
        "required": [
          "thread_id",
          "subject",
          "participants",
          "messages"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThreadMessageResponse"
            }
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          },
          "subject": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Liveness, readiness, and operational probes."
    }
  ]
}
