{
  "openapi": "3.1.0",
  "info": {
    "title": "hail",
    "description": "Task-oriented HTTP+JSON API for hail (self-hosted hey.com-style email front-end on top of Stalwart/JMAP). See docs/design.md §7 for the verb/view model.",
    "contact": {
      "name": "Martin Trojer",
      "email": "martin.trojer@gmail.com"
    },
    "license": {
      "name": "AGPL-3.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/compose": {
      "post": {
        "tags": [
          "compose"
        ],
        "operationId": "compose",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComposePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Message sent immediately.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComposeResponse"
                }
              }
            }
          },
          "201": {
            "description": "Message draft scheduled for later delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComposeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid compose payload."
          },
          "401": {
            "description": "Missing or invalid session."
          },
          "500": {
            "description": "JMAP provider or scheduler failure."
          }
        }
      }
    },
    "/api/drafts": {
      "post": {
        "tags": [
          "drafts"
        ],
        "operationId": "create_draft",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Draft created or autosaved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid draft payload."
          },
          "401": {
            "description": "Missing or invalid session."
          },
          "500": {
            "description": "JMAP draft store failure."
          }
        }
      }
    },
    "/api/drafts/{draft_id}": {
      "patch": {
        "tags": [
          "drafts"
        ],
        "operationId": "update_draft",
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "description": "JMAP draft email id to update.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Draft updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid draft id or payload."
          },
          "401": {
            "description": "Missing or invalid session."
          },
          "500": {
            "description": "JMAP draft store failure."
          }
        }
      }
    },
    "/api/threads/{thread_id}": {
      "get": {
        "tags": [
          "threads"
        ],
        "operationId": "get_thread",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "JMAP thread id to render as a sanitized document.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thread rendered as sanitized HTML messages.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadViewResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid thread id."
          },
          "401": {
            "description": "Missing or invalid session."
          },
          "404": {
            "description": "Thread not found."
          },
          "500": {
            "description": "Thread assembly failed."
          }
        }
      }
    },
    "/api/threads/{thread_id}/reply": {
      "post": {
        "tags": [
          "compose"
        ],
        "operationId": "reply",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "JMAP thread id to reply to.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplyPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Reply sent immediately.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComposeResponse"
                }
              }
            }
          },
          "201": {
            "description": "Reply draft scheduled for later delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComposeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid thread id or reply payload."
          },
          "401": {
            "description": "Missing or invalid session."
          },
          "404": {
            "description": "Thread not found."
          },
          "500": {
            "description": "JMAP provider or scheduler failure."
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe.",
        "description": "Returns 204 No Content if the process is up enough to accept HTTP.\nIntended for container orchestrators (Kubernetes `livenessProbe`,\nDocker `HEALTHCHECK`, etc.) \u2014 a failing liveness check should\nrestart the container.",
        "operationId": "healthz",
        "responses": {
          "204": {
            "description": "Process is alive."
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Readiness probe.",
        "description": "Returns 200 OK once the SQLite pool answers `SELECT 1`, otherwise\n503 Service Unavailable. Designed for `readinessProbe` style\ngating: a failing readiness check should remove the instance from\nload-balancer rotation but *not* restart it.\n\nPer design.md §7.5 the production check will also verify the JMAP\nsession; that's wired in by the `jmap-eventsource` task.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "All dependencies reachable."
          },
          "503": {
            "description": "A dependency is unhealthy."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BlockedTrackerResponse": {
        "type": "object",
        "required": [
          "src",
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "src": {
            "type": "string"
          }
        }
      },
      "ComposePayload": {
        "type": "object",
        "required": [
          "to",
          "subject",
          "body_markdown"
        ],
        "properties": {
          "attachments": {
            "type": [
              "array",
              "null"
            ],
            "items": {}
          },
          "bcc": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "body_markdown": {
            "type": "string"
          },
          "cc": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "send_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "subject": {
            "type": "string"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ComposeResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "scheduled_send_id",
              "draft_email_id",
              "status"
            ],
            "properties": {
              "draft_email_id": {
                "type": "string"
              },
              "scheduled_send_id": {
                "type": "integer",
                "format": "int64"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "email_id",
              "status"
            ],
            "properties": {
              "email_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "sent"
                ]
              },
              "submission_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        ]
      },
      "DraftPayload": {
        "type": "object",
        "properties": {
          "attachments": {
            "type": [
              "array",
              "null"
            ],
            "items": {}
          },
          "bcc": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "body_markdown": {
            "type": [
              "string",
              "null"
            ]
          },
          "cc": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DraftResponse": {
        "type": "object",
        "required": [
          "draft_id",
          "updated_at"
        ],
        "properties": {
          "draft_id": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Participant": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ReplyPayload": {
        "type": "object",
        "required": [
          "body_markdown"
        ],
        "properties": {
          "attachments": {
            "type": [
              "array",
              "null"
            ],
            "items": {}
          },
          "body_markdown": {
            "type": "string"
          },
          "send_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ThreadMessageResponse": {
        "type": "object",
        "required": [
          "email_id",
          "from",
          "to",
          "html",
          "preview",
          "blocked_trackers"
        ],
        "properties": {
          "blocked_trackers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlockedTrackerResponse"
            }
          },
          "email_id": {
            "type": "string"
          },
          "from": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          },
          "html": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "to": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          }
        }
      },
      "ThreadViewResponse": {
        "type": "object",
        "required": [
          "thread_id",
          "subject",
          "participants",
          "messages"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThreadMessageResponse"
            }
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          },
          "subject": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Liveness, readiness, and operational probes."
    },
    {
      "name": "compose",
      "description": "Compose, reply, and scheduled-send creation."
    },
    {
      "name": "drafts",
      "description": "Draft autosave create/update endpoints."
    }
  ]
}
