# Required: 64-character hex string (32 bytes). Generate with: openssl rand -hex 32
HAIL_SERVER_KEY=
# Public URL for cookie/CSRF binding (no trailing slash)
HAIL_PUBLIC_URL=https://hail.example.com

# === Cloudflare Tunnel overlay ===
# Required when using docker-compose.cloudflare.yml.
# Get this from Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Install connector.
CLOUDFLARE_TUNNEL_TOKEN=
