# Stalwart recovery admin for first-run Stalwart bootstrap and the
# stalwart-init settings sidecar. Required only for the self-host Compose
# flavour. Use a long random password in production.
STALWART_RECOVERY_ADMIN=admin:admin1234

# Required: choose one Compose flavour overlay when starting the stack:
#   docker compose -f docker-compose.yml -f docker-compose.gmail.yml up -d --build
#   docker compose -f docker-compose.yml -f docker-compose.selfhost.yml up -d --build
# See docs/setup-runbook.md for the full first-run flow.

# Required: 64-character hex string (32 bytes). Generate with: openssl rand -hex 32
HAIL_SERVER_KEY=
# Required for first-run wizard POST when HAIL_SETUP_BOOTSTRAP_ENABLED=true.
# Generate with: openssl rand -hex 32
HAIL_SETUP_BOOTSTRAP_TOKEN=
# Public URL for cookie/CSRF binding (no trailing slash)
HAIL_PUBLIC_URL=https://hail.example.com

# Blob store path inside the hail-api and hail-worker containers. The shipped
# Compose files mount the shared hail-blobs volume here; only change this if you
# also change both service mounts.
HAIL_BLOB_ROOT=/var/lib/hail/blobs

# === Cloudflare Tunnel overlay ===
# Required when using docker-compose.cloudflare.yml.
# Get this from Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Install connector.
CLOUDFLARE_TUNNEL_TOKEN=

# === Gmail flavour overlay ===
# Required when using docker-compose.gmail.yml. Configure the Google OAuth
# client with this redirect URI:
#   ${HAIL_PUBLIC_URL}/api/provider-accounts/gmail/callback
# For local smoke, use:
#   http://127.0.0.1:8080/api/provider-accounts/gmail/callback
HAIL_MAIL__GMAIL__OAUTH_CLIENT_ID=
HAIL_MAIL__GMAIL__OAUTH_CLIENT_SECRET=
# Defaults normally do not need changing.
HAIL_MAIL__GMAIL__OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
HAIL_MAIL__GMAIL__OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
HAIL_MAIL__GMAIL__OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke

# Optional shared cache knobs. Defaults are flavour-aware:
# - Gmail overlay: bounded + incremental backfill.
# - Self-host overlay: bounded + no historical backfill.
# HAIL_MAIL__CACHE__MODE=bounded
# HAIL_MAIL__CACHE__BACKFILL=incremental

# === Optional Gmail/provider import for self-host flavour ===
# Legacy/self-host provider import still accepts these vars when connecting
# Gmail at /provider-accounts while running the self-host JMAP backend. The
# Gmail flavour above prefers HAIL_MAIL__GMAIL__*.
# Required only when connecting Gmail at /provider-accounts on self-host. Configure the
# Google OAuth client with this redirect URI for local smoke:
#   http://127.0.0.1:8080/api/provider-accounts/gmail/callback
# For HTTPS deployments, replace the origin with HAIL_PUBLIC_URL.
# Optional: cap the initial historical import during live smoke/dev to avoid
# filling a small local Stalwart blob store. Leave blank/unset for full import.
HAIL_PROVIDER_IMPORT__GMAIL__OAUTH_CLIENT_ID=
HAIL_PROVIDER_IMPORT__GMAIL__OAUTH_CLIENT_SECRET=
HAIL_PROVIDER_IMPORT__GMAIL__INITIAL_IMPORT_MAX_MESSAGES=

# === Optional provider-import smarthost overlay ===
# Only used when you run with docker-compose.provider-smarthost.yml and a private
# Stalwart config that references these env vars. Leave blank for normal
# non-provider deployments. Never commit real provider SMTP credentials.
# Gmail example:
#   HAIL_PROVIDER_SMTP_HOST=smtp.gmail.com
#   HAIL_PROVIDER_SMTP_USERNAME=you@gmail.com
#   HAIL_PROVIDER_SMTP_SECRET=<gmail app password or Workspace SMTP credential>
# Generic relay example:
#   HAIL_PROVIDER_SMTP_HOST=smtp.relay.example
#   HAIL_PROVIDER_SMTP_USERNAME=<provider SMTP username>
#   HAIL_PROVIDER_SMTP_SECRET=<provider SMTP password or API key>
HAIL_PROVIDER_SMTP_HOST=
HAIL_PROVIDER_SMTP_USERNAME=
HAIL_PROVIDER_SMTP_SECRET=

# === Optional Litestream hail.db backup overlay ===
# Only used when you run with docker-compose.litestream.yml. Leave blank for
# normal local/dev usage. The checked-in example config defaults to a local file
# replica at ./backups/litestream and does not need cloud credentials.
LITESTREAM_LOCAL_BACKUP_PATH=./backups/litestream
# For S3 or Cloudflare R2, edit deploy/litestream.yml and set these values.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_REGION=us-east-1
LITESTREAM_BUCKET=
LITESTREAM_PATH=hail.db
# R2/custom S3 endpoint example: https://ACCOUNT_ID.r2.cloudflarestorage.com
LITESTREAM_ENDPOINT=
